{
 "palette": {
  "claret": {
   "hex": "#4A1420",
   "use": "Claret: the house colour. Deep red wool, the lining of a jewel box, the evening."
  },
  "oxblood": {
   "hex": "#2B0B12",
   "use": "Oxblood: claret in shadow, for the deepest grounds and the footer."
  },
  "brass": {
   "hex": "#C2A36B",
   "use": "Brass: the metal. The monogram, rules and figures on claret and ink, never small text on ivory."
  },
  "ivory": {
   "hex": "#F5EFE4",
   "use": "Ivory: the page. Undyed cotton, honed limestone, where the brands' own logos sit."
  },
  "linen": {
   "hex": "#E8DECD",
   "use": "Linen: the second ground, for plates and panels on ivory."
  },
  "ink": {
   "hex": "#1B1416",
   "use": "Ink: text, a warm black with claret in it."
  },
  "cypress": {
   "hex": "#1D3A32",
   "use": "Cypress: the deep green of the Levant's trees, for industry, property and people."
  },
  "stone": {
